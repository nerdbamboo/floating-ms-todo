# MS To Do 연동 — Azure App 등록 후 발급
# https://entra.microsoft.com → App registrations → New registration
# Redirect URI 불필요 (Device Code Flow 사용). API 권한: Tasks.ReadWrite, offline_access
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# 개인 MS 계정(outlook.com/hotmail)은 consumers, 회사/학교는 organizations, 둘 다면 common
AZURE_TENANT_ID=consumers

# 사용할 Todo 백엔드: memory | mstodo
TODO_BACKEND=memory
# MS To Do 기본 리스트가 없으면 만들 리스트 이름
TODO_DEFAULT_LIST=Tasks

# LLM — OpenAI 호환 엔드포인트면 전부 OK (OpenAI / Azure / Ollama / vLLM / LM Studio ...)
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.2

# Floating 창 기본값
FLOAT_OPACITY=0.95
FLOAT_ALWAYS_ON_TOP=true
FLOAT_WIDTH=360
FLOAT_HEIGHT=520
